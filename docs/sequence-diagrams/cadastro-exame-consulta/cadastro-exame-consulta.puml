@startuml cadastro-exame-consulta
title Cadastro de Exames e Consultas da Gestante (Médico)
autonumber

actor "Médico" as Medico
boundary "Tela de Cadastro\nde Exames e Consultas" as Tela
control "TipoAtendimentoController" as TipoController
control "AgendamentoController" as Controller
participant "AgendamentoService" as Service
participant "TipoAtendimentoService" as Tipos
database "Banco de Dados" as BD

Medico -> Tela : Abre a gestante e acessa\n"Cadastrar exame ou consulta"
Tela -> TipoController : GET /tipos-atendimento
TipoController -> Tipos : disponiveis(idMedico do token)
Tipos -> BD : buscarTipos(ativo = true, padrão ou do médico)
BD --> Tipos : tipos de atendimento
Tipos --> TipoController : tipos de atendimento
TipoController --> Tela : 200 OK
Tela --> Medico : Exibe formulário com os tipos disponíveis

Medico -> Tela : Informa um ou mais itens:\ntipo, data prevista e observação
Tela -> Controller : POST /agendamentos\n(gestante, itens: [tipoAtendimento, dataPrevista, observacao])

alt dados inválidos (campo obrigatório ausente, sem itens, mais de 20 itens ou data prevista no passado)
    Controller --> Tela : 400 Bad Request
    Tela --> Medico : Exibe os erros de validação
else dados válidos
    Controller -> Service : agendar(dados, idMedico do token)
    Service -> BD : buscarGestante(idGestante, idMedico)
    BD --> Service : resultado

    alt gestante não encontrada ou fora do alcance do médico
        Service --> Controller : Erro: gestante não encontrada
        Controller --> Tela : 404 Not Found
        Tela --> Medico : Exibe mensagem "Gestante não encontrada"
    else gestante encontrada
        loop para cada item
            Service -> Tipos : paraAgendamento(idMedico, idTipoAtendimento)
            Tipos -> BD : buscarTipoAtendimento(idTipoAtendimento)
            BD --> Tipos : resultado
        end

        alt algum tipo inexistente, inativo ou de outro médico
            Tipos --> Service : Erro: tipo de atendimento inválido
            Service --> Controller : Erro: tipo de atendimento inválido
            Controller --> Tela : 400 Bad Request
            Tela --> Medico : Exibe mensagem "Tipo de atendimento inválido"
        else todos os tipos válidos
            Service -> BD : salvarAgendamentos(um por item: gestante, tipo, atribuidoPor = idMedico,\ndataPrevista, observacao, status = AGENDADO)
            BD --> Service : agendamentos salvos
            Service -> BD : registrarLog(idMedico, agendamentos, evento = AGENDAMENTO_CRIADO)\n(previsto: log_auditoria ainda não tem migração)
            Service --> Controller : agendamentos
            Controller --> Tela : 201 Created
            Tela --> Medico : Exibe os exames e consultas cadastrados na página da gestante
            note over Medico, Service
                Nenhum ponto é creditado aqui: os pontos do tipo de atendimento
                só são gerados quando o médico confirmar a realização.
                Tudo na mesma transação: um tipo inválido não deixa metade do cadastro gravada.
            end note
        end
    end
end

@enduml
