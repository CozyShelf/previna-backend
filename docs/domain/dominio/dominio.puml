@startuml dominio
!pragma layout smetana
title PREVINA - Modelo lógico do banco de dados
hide circle
hide stereotype

legend top right
  Tabelas criadas nas migrações (V1 a V24).
  • campo obrigatório (NOT NULL)
endlegend

entity usuario {
  * id : bigint <<PK>>
  --
  * nome : varchar
  cpf : varchar <<UK>>
  email : varchar <<UK>>
  * login : varchar <<UK>>
  * senha_hash : varchar
  * perfil : varchar
  * status_conta : varchar
  * criado_em : timestamp
}

entity medico {
  * usuario_id : bigint <<PK>> <<FK>>
  --
  * crm : varchar <<UK>>
  * ver_todas_gestantes : boolean
}

entity gestante {
  * usuario_id : bigint <<PK>> <<FK>>
  --
  * medico_id : bigint <<FK>>
  * data_nascimento : date
  * telefone : varchar
  * dum : date
  * data_provavel_parto : date
  * saldo_pontos : int
  * consentimento_lgpd : boolean
  data_consentimento : timestamp
  * tutorial_concluido : boolean
}

entity foto_gestante {
  * gestante_id : bigint <<PK>> <<FK>>
  --
  * conteudo : bytea
  * tipo : varchar
}

entity dados_socioeconomicos {
  * gestante_id : bigint <<PK>> <<FK>>
  --
  renda_familiar : decimal
  pessoas_domicilio : int
  escolaridade : varchar
  beneficiaria_programa_social : boolean
  * fator_ponderacao : decimal
}

entity empresa_parceira {
  * usuario_id : bigint <<PK>> <<FK>>
  --
  * razao_social : varchar
  * cnpj : varchar <<UK>>
  telefone : varchar
  responsavel : varchar
  endereco : varchar
  logo_url : varchar
  descricao : text
  segmento : varchar
}

entity logo_empresa {
  * empresa_id : bigint <<PK>> <<FK>>
  --
  * conteudo : bytea
  * tipo : varchar
}

entity produto {
  * id : bigint <<PK>>
  --
  * empresa_id : bigint <<FK>>
  * nome : varchar
  descricao : text
  categoria : FRALDAS | ROUPAS | REMEDIOS
  preco : decimal (sem desconto)
  imagem_url : varchar
}

entity imagem_produto {
  * produto_id : bigint <<PK>> <<FK>>
  --
  * conteudo : bytea
  * tipo : varchar
}

entity promocao {
  * id : bigint <<PK>>
  --
  * empresa_id : bigint <<FK>>
  * titulo : varchar
  descricao : text
  * desconto : decimal (%)
  * data_inicio : date
  * data_fim : date
  * categoria : FRALDAS | ROUPAS | REMEDIOS
  * ativo : boolean
}

entity cupom {
  * id : bigint <<PK>>
  --
  * empresa_id : bigint <<FK>>
  * produto_id : bigint <<FK>>
  * desconto : decimal (%)
  * data_validade : date
  * pontos_necessarios : int
  * ativo : boolean
}

entity tipo_atendimento {
  * id : bigint <<PK>>
  --
  criado_por : bigint <<FK>>
  * nome : varchar
  * categoria : EXAME | CONSULTA
  descricao : text
  * pontos_base : int
  * ativo : boolean
}

entity agendamento {
  * id : bigint <<PK>>
  --
  * gestante_id : bigint <<FK>>
  * tipo_atendimento_id : bigint <<FK>>
  * atribuido_por : bigint <<FK>>
  confirmado_por : bigint <<FK>>
  * data_prevista : date
  * status : AGENDADO | REALIZADO | NAO_COMPARECEU
  data_confirmacao : timestamp
  observacao : text
}

entity transacao_pontos {
  * id : bigint <<PK>>
  --
  * gestante_id : bigint <<FK>>
  agendamento_id : bigint <<FK>> <<UK>>
  cupom_resgatado_id : bigint <<FK>> <<UK>>
  * tipo : CREDITO | DEBITO
  * pontos : int
  fator_aplicado : decimal
  * data_hora : timestamp
}

entity cupom_resgatado {
  * id : bigint <<PK>>
  --
  * tipo : CUPOM | PROMOCAO
  cupom_id : bigint <<FK>> (só CUPOM)
  promocao_id : bigint <<FK>> (só PROMOCAO)
  * gestante_id : bigint <<FK>>
  * codigo : varchar <<UK>>
  * status : ATIVO | UTILIZADO | EXPIRADO
  * data_resgate : timestamp
  data_uso : timestamp
  chave_idempotencia : uuid
  .. cópia do cupom no resgate (só CUPOM) ..
  produto_id : bigint <<FK>>
  produto_nome : varchar
  pontos_gastos : int
  .. cópia da promoção no resgate (só PROMOCAO) ..
  titulo : varchar
  categoria : FRALDAS | ROUPAS | REMEDIOS
  .. cópia dos dois ..
  * empresa_id : bigint <<FK>>
  * empresa_nome : varchar
  * desconto : decimal
  * data_validade : date (na promoção, a data_fim)
}

entity conteudo_informativo {
  * id : bigint <<PK>>
  --
  * autor_id : bigint <<FK>> (admin)
  * titulo : varchar
  * categoria : DICA | NOTICIA | AVISO
  * tipo : TEXTO | FOTO | VIDEO | LINK
  resumo : varchar
  corpo : text (obrigatório no TEXTO)
  midia_url : varchar (obrigatório fora do TEXTO)
  * publicado : boolean
  * criado_em : timestamp
  publicado_em : timestamp
}

entity imagem_conteudo {
  * conteudo_id : bigint <<PK>> <<FK>>
  --
  * conteudo : bytea
  * tipo : varchar
}

entity log_auditoria {
  * id : bigint <<PK>>
  --
  * data_hora : timestamp
  * acao : AGENDAMENTO_CRIADO | AGENDAMENTO_REALIZADO
    | AGENDAMENTO_NAO_COMPARECEU | CUPOM_RESGATADO
    | PROMOCAO_RESGATADA | RESGATE_VALIDADO
  * usuario_id : bigint <<FK>> (quem fez)
  * gestante_id : bigint <<FK>>
  agendamento_id : bigint <<FK>>
  transacao_pontos_id : bigint <<FK>>
  cupom_resgatado_id : bigint <<FK>>
  pontos : int (cópia)
}

usuario ||--o| medico
usuario ||--o| gestante
usuario ||--o| empresa_parceira
usuario ||--o{ conteudo_informativo
conteudo_informativo ||--o| imagem_conteudo
usuario ||--o{ log_auditoria : usuario_id

medico ||--o{ gestante
gestante ||--o| foto_gestante
gestante ||--o| dados_socioeconomicos

empresa_parceira ||--o| logo_empresa
empresa_parceira ||--o{ produto
empresa_parceira ||--o{ promocao
empresa_parceira ||--o{ cupom
produto ||--o| imagem_produto
produto ||--o{ cupom

cupom |o--o{ cupom_resgatado
promocao |o--o{ cupom_resgatado
produto ||--o{ cupom_resgatado
empresa_parceira ||--o{ cupom_resgatado
gestante ||--o{ cupom_resgatado

gestante ||--o{ agendamento
tipo_atendimento ||--o{ agendamento
medico ||--o{ agendamento : atribuido_por
medico |o--o{ agendamento : confirmado_por
medico |o--o{ tipo_atendimento : criado_por

gestante ||--o{ transacao_pontos
agendamento |o--o| transacao_pontos
cupom_resgatado |o--o| transacao_pontos : cupom_resgatado_id
gestante ||--o{ log_auditoria
agendamento |o--o{ log_auditoria
transacao_pontos |o--o{ log_auditoria
cupom_resgatado |o--o{ log_auditoria

note bottom of tipo_atendimento
  Sem criado_por: tipo padrão, disponível para todos os médicos.
  O nome é único por dono (nome, criado_por).
end note

note bottom of agendamento
  Pendente (AGENDADO) passa a REALIZADO ou NAO_COMPARECEU,
  só pelo médico. transacao_pontos.agendamento_id é UNIQUE:
  a confirmação credita os pontos uma vez só.
  Um AGENDADO só por (gestante_id, tipo_atendimento_id, data_prevista):
  índice único parcial agendamento_pendente_unico (V21).
end note

note bottom of promocao
  Sem ligação direta com produto: a promoção vale
  para todos os produtos da empresa com a mesma categoria.
  Resgatável sem pontos, uma vez por gestante; desativada sai do catálogo.
  Uma ATIVA só por (empresa_id, categoria) em cada período:
  exclusão promocao_sem_sobreposicao (V23).
end note

note bottom of cupom_resgatado
  Cupom e promoção resgatados na mesma tabela (V22).
  CHECK cupom_resgatado_tipo_coerente: cada tipo preenche a sua cópia.
  Promoção uma vez por gestante: índice único
  cupom_resgatado_promocao_uma_vez (gestante_id, promocao_id);
  no cupom promocao_id é nulo e não colide (N resgates).
  UNIQUE (gestante_id, chave_idempotencia) (V20).
end note

note bottom of log_auditoria
  Log de auditoria (RF18, V24): uma linha por operação, gravada
  na mesma transação dela. Só INSERT: o gatilho
  log_auditoria_somente_insercao barra UPDATE e DELETE.
end note

@enduml
