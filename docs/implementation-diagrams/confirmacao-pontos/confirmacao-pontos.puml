@startuml confirmacao-pontos
title Confirmação de exame ou consulta e crédito de pontos

|AgendamentoController|
start
:PUT /agendamentos/{id}/confirmar
@PreAuthorize MEDICO;

|AgendamentoService|
:trava o agendamento pelo id
(SELECT ... FOR UPDATE);
if (não encontrado ou gestante fora
do alcance do médico do token?) then (sim)
  |AgendamentoController|
  :404 Not Found;
  stop
else (não)
endif

|AgendamentoService|
if (status diferente de AGENDADO
(já REALIZADO ou NAO_COMPARECEU)?) then (sim)
  |AgendamentoController|
  :409 Conflict;
  stop
else (não)
endif

|AgendamentoService|
if (data prevista depois de hoje?) then (sim)
  |AgendamentoController|
  :409 Conflict;
  stop
else (não)
endif

|AgendamentoService|
:status = REALIZADO
confirmado_por = médico autenticado
data_confirmacao = agora;

|PontuacaoService|
:trava e relê a gestante
(SELECT ... FOR UPDATE);
:pontos = arredondar(tipo_atendimento.pontos_base
× dados_socioeconomicos.fator_ponderacao)
(fator 1,00 sem dados socioeconômicos);
:insere transacao_pontos
(tipo = CREDITO, pontos, fator_aplicado, agendamento);
:gestante.saldo_pontos += pontos;

|AgendamentoService|
:insere log_auditoria (previsto)
(médico, agendamento, transação,
evento = AGENDAMENTO_CONFIRMADO);

|AgendamentoController|
:200 OK
(agendamento, pontos creditados e saldo);
stop

note right
  Status, transação de pontos, saldo e log
  na mesma transação (@Transactional):
  ou tudo é gravado, ou nada.
  A trava da gestante é a mesma do resgate:
  créditos e débitos simultâneos não
  perdem pontos do saldo.
  O cadastro do agendamento
  (POST /agendamentos) não credita pontos.
end note

@enduml
